# ─────────────────────────────────────────────────────────────
# 로컬 전용 설정 템플릿
#
#   1. 이 파일을 application-local.yml 로 복사한다
#   2. 안내 메일로 받은 값을 채운다
#   3. application-local.yml 은 .gitignore 대상이다 — 절대 커밋하지 않는다
#
# ⚠️ PDF/메일에서 값을 복사·붙여넣기 하지 말 것.
#    전각 따옴표(“ ”)·전각 하이픈(－)이 섞여 들어오면 API 호출 또는 복호화가
#    조용히 실패한다. 원인 추적이 매우 어려우므로 직접 타이핑을 권장한다.
#
# 이 파일 대신 환경변수로 주입해도 된다 (application.yml 에 매핑돼 있음):
#   INSPIEN_API_USERNAME / INSPIEN_API_PASSWORD
#   INSPIEN_APPLICANT_NAME / INSPIEN_APPLICANT_PHONE / INSPIEN_APPLICANT_EMAIL
#
# 적재 대상(Oracle/FTP) 접속정보는 여기에 쓰지 않는다.
# BOOT-000 이 복호화해 secrets/*.properties 로 떨어뜨리고, SecretsLoader 가 읽는다.
# ─────────────────────────────────────────────────────────────
inspien:
  bootstrap:
    # 과제 API HTTP Basic 인증
    username: "CHANGE_ME"
    password: "CHANGE_ME"

    applicant:
      # 지원자명. FTP 영수증 파일명(INSPIEN_{참여자명}_yyyyMMddHHmmss.txt)에 그대로 쓰인다
      name: "홍길동"

      # ⚠️ 이 문자열 자체가 복호화 키의 seed 다 (SHA-1 → 앞 16바이트 → AES-128 키).
      #    하이픈 유무·공백 하나만 달라도 접속정보 복호화가 전부 실패한다.
      #    안내받은 형식 그대로: 010-1234-5678
      phone-number: "010-0000-0000"

      email: "you@example.com"
